 "definitions": {
  "entries_observed_mal_with_better_alt": "ketersediaan saja: ada kandidat lain dgn trust lebih tinggi (atau sink); tidak memperhitungkan fitur lain",
  "counterfactual_training_scale": "trust dipetakan (10t+1)/12; mempersempit rentang, jadi TIDAK memisahkan hipotesis bobot-kecil vs ekstrapolasi",
  "flip_trust0": "keputusan (next-hop sensor) yang argmax-nya berubah bila HANYA trust kandidat terpilih di-set 0",
  "mal_alt_lq_better / mal_alt_progress_better": "pada entri malicious teramati, ada alternatif lebih tepercaya yang link quality (prr*stability) / progresnya juga lebih baik"
 },
 "note": "label hanya untuk evaluasi; TLDQN tidak diubah"
}