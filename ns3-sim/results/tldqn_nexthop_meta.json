  "energy": "1.0 untuk semua sensor (keputusan di awal simulasi)",
  "trust": "reputasi pra-deploy tersimulasi dari ground truth skenario (EnvConfig.trust_obs observasi); diganti telemetry NS-3 di langkah 2",
  "stability": "proksi Python, scenario_seed = 10000*seed + n",
  "malicious_relay": "meneruskan dgn peluang 0.3 (grayhole); NS-3 harus memakai nilai yang sama"
 },
 "env_config": {
  "prr_d50": 120.0,
  "prr_width": 10.0,
  "stability_min": 0.8,
